# ESP32-C3 SuperMini, BLE observer only.
CONFIG_IDF_TARGET="esp32c3"

# SuperMini exposes the console over the native USB Serial/JTAG port, not UART0.
# Without this, `idf.py monitor` over /dev/ttyACM* shows no output.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Bluetooth LE: NimBLE host, observer role only ------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Nothing here connects, advertises or acts as a central; dropping the unused
# roles saves RAM and flash.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# No WiFi here, so the radio is not shared and coexistence is not needed. This
# is why the scan window can run at a much higher duty cycle than the sidecar's.
