formula.aodv_active_route_ms=timer.gtt_hard_expiry_ms*6/5
formula.aodv_blacklist_ms=2*timer.aodv_net_traversal_ms
formula.aodv_net_traversal_ms=2*timer.aodv_net_diameter*timer.aodv_node_traversal_ms
formula.aodv_path_discovery_ms=2*timer.aodv_net_traversal_ms
formula.gtt_departed_ms=2*timer.gtt_hard_expiry_ms
formula.gtt_maintenance_ms=max(1000,timer.gtt_hard_expiry_ms/12)
formula.link_no_response_wall_bound_ms=timer.link_response_window_sum_ms+timer.link_max_attempts*timer.link_tx_scheduler_attempt_bound_ms
formula.link_response_window_sum_ms=timer.link_max_attempts*timer.link_hack_timeout_ms
formula.link_tx_scheduler_attempt_bound_ms=(timer.scheduler_custody_bypass_max+1)*(timer.radio_tx_event_bound_ms+timer.scheduler_poll_max_ms)
formula.mentor_page_timeout_ms=2*timer.aodv_net_traversal_ms
formula.radio_tx_event_bound_ms=4*timer.radio_state_timeout_ms
formula.repair_timeout_ms=2*timer.aodv_path_discovery_ms+500
formula.verification_window_ms=timer.aodv_net_traversal_ms+3*timer.aodv_path_discovery_ms
